  {
    "id": "arduino99-html",
    "z": "arduino99-panel",
    "type": "template",
    "name": "Panel del invernadero",
    "x": 400,
    "y": 330,
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Greenhouse monitoring | Group 99</title>\n<style>\n:root{color-scheme:light;--ink:#162f3b;--muted:#485f69;--line:#ccd5d6;--paper:#fff;--teal:#176754;--amber:#995415;--blue:#325c96;font:16px \"Source Sans 3\",Arial,sans-serif;color:var(--ink);background:#f4f6f4}\n*{box-sizing:border-box}body{margin:0}.shell{max-width:1250px;margin:auto;padding:0 clamp(16px,3.8vw,52px)}\nheader{background:#173440;color:#fff}.bar,.title-row,.heading,.metric-label,.status-row,.actions,.plot-controls{display:flex;align-items:center;justify-content:space-between;gap:12px}.bar{min-height:52px;font-size:.88rem}.bar strong{font-weight:600;letter-spacing:.025em}\n.signal::before{content:\"\";display:inline-block;width:.55rem;height:.55rem;margin-right:.5rem;border-radius:50%;background:#b7c1c4}.signal.online::before{background:#87d8a9}\n.title-row{margin:30px 0 22px;align-items:end}h1,h2,h3,p,figure{margin:0}h1,h2{font-family:\"STIX Two Text\",Georgia,serif;font-weight:500}h1{font-size:clamp(2rem,3.8vw,3.25rem);letter-spacing:-.045em}h2{font-size:1.45rem}\n.meta,.small,figcaption,.clock,label,.note{font-size:.86rem;color:var(--muted);line-height:1.45}.mono,.reading,.clock,input,.status-row b{font-variant-numeric:tabular-nums}.clock{text-align:right}\n.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:var(--paper);border:1px solid var(--line);margin-bottom:18px}\n.metric{padding:18px 22px;border-right:1px solid var(--line)}.metric:last-child{border:0}.metric-label{justify-content:start;font-weight:650;font-size:.94rem}.swatch{width:14px;height:3px;background:var(--series)}.reading{font-size:clamp(1.9rem,3.7vw,3rem);letter-spacing:-.045em;line-height:1.3}.reading small{font-size:.43em;letter-spacing:0;color:var(--muted)}\n.layout{display:grid;gap:18px}.panel{background:var(--paper);border:1px solid var(--line);padding:22px;min-width:0}.stack{display:grid;grid-template-columns:1fr 1fr;gap:18px}.heading{align-items:baseline}.plot-controls{justify-content:start;flex-wrap:wrap;margin:16px 0 4px;gap:5px}\nbutton,input{font:inherit;border:1px solid #a9b8ba;border-radius:3px;background:white;color:var(--ink)}button{font-size:.88rem;font-weight:600;cursor:pointer;padding:8px 11px}button:hover:enabled{background:#e8eeeb}button[aria-pressed=true],button.primary{background:#193c46;color:white;border-color:#193c46}button[aria-pressed=true]:hover:enabled,button.primary:hover:enabled{background:#29515b}button:disabled,input:disabled{opacity:.55;cursor:default}\nbutton:focus-visible,input:focus-visible{outline:3px solid #b96b30;outline-offset:2px}canvas{width:100%;height:240px;display:block}.chart-info{border-top:1px solid var(--line);padding-top:9px}.status-row{border-bottom:1px solid #e0e5e4;align-items:baseline;padding:9px 0;font-size:.9rem}.status-row b{text-align:right;font-weight:600}.actions{justify-content:start;flex-wrap:wrap;margin:14px 0 8px;gap:5px}\nfieldset{border:0;padding:0;min-width:0;margin:14px 0}legend{font-weight:650;font-size:.94rem;margin-bottom:6px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}input{display:block;width:100%;padding:8px;margin-top:3px}.message{color:var(--teal);font-size:.9rem;margin-top:6px}.message:empty{margin:0}\n.note{margin:10px 0 0}footer{color:var(--muted);font-size:.82rem;padding:16px 0 26px}\n@media(max-width:850px){.layout{grid-template-columns:1fr}.stack{grid-template-columns:1fr 1fr}.panel{padding:16px}}\n@media(max-width:610px){.stack{grid-template-columns:1fr}.title-row{align-items:start;flex-direction:column;margin:20px 0 14px}.clock{text-align:left}.metric{padding:10px 7px}.metric-label{font-size:.78rem;gap:4px}.swatch{width:7px}.reading{font-size:1.7rem}.metric .small{font-size:.74rem}.bar{font-size:.76rem}canvas{height:205px}}\n</style></head><body>\n<header><div class=\"shell bar\"><strong>ICAI · Internet of Things Laboratory</strong><span class=\"signal\" id=\"connection\">Connecting</span></div></header>\n<main class=\"shell\">\n<div class=\"title-row\"><div><h1>Greenhouse monitoring</h1><p class=\"meta\">Group 99 · Arduino sensors · Raspberry Pi 16</p></div><div class=\"clock\">Last panel update <time id=\"updated\">—</time></div></div>\n<div class=\"metrics\">\n<div class=\"metric\" style=\"--series:var(--amber)\"><div class=\"metric-label\"><i class=\"swatch\"></i>Temperature</div><div class=\"reading\"><output id=\"temperatura\">—</output> <small>°C</small></div><div class=\"small\" id=\"age-temperatura\">Awaiting reading</div></div>\n<div class=\"metric\" style=\"--series:var(--blue)\"><div class=\"metric-label\"><i class=\"swatch\"></i>Relative humidity</div><div class=\"reading\"><output id=\"humedad\">—</output> <small>%</small></div><div class=\"small\" id=\"age-humedad\">Awaiting reading</div></div>\n<div class=\"metric\" style=\"--series:var(--teal)\"><div class=\"metric-label\"><i class=\"swatch\"></i>Water level</div><div class=\"reading\"><output id=\"nivel\">—</output> <small>%</small></div><div class=\"small\" id=\"water\">Awaiting reading</div></div>\n</div>\n<div class=\"layout\"><section class=\"panel\"><div class=\"heading\"><h2>Measurement history</h2><span class=\"small\">Last 5 min</span></div>\n<div class=\"plot-controls\" role=\"group\" aria-label=\"Chart measurement\"><button data-series=\"temperatura\" aria-pressed=\"true\">Temperature</button><button data-series=\"humedad\" aria-pressed=\"false\">Humidity</button><button data-series=\"nivel\" aria-pressed=\"false\">Water level</button></div>\n<figure><canvas id=\"plot\" role=\"img\" aria-label=\"Measured values over the last five minutes\"></canvas><figcaption id=\"plot-summary\" class=\"chart-info\">Waiting for sensor data.</figcaption></figure></section>\n<div class=\"stack\"><section class=\"panel\"><div class=\"heading\"><h2>Lamp control</h2><span class=\"small\">SONOFF 9</span></div>\n<div class=\"status-row\">Operating mode<b id=\"mode\">—</b></div><div class=\"status-row\">Commanded state<b id=\"requested\">—</b></div><div class=\"status-row\">Last relay report<b id=\"report\">—</b></div>\n<div class=\"actions\"><button type=\"button\" data-mode=\"auto\" disabled>Automatic</button><button type=\"button\" data-mode=\"on\" disabled>Switch on</button><button type=\"button\" data-mode=\"off\" disabled>Switch off</button></div>\n<p class=\"small\">Select Automatic to resume temperature control. A stale temperature reading cancels manual ON.</p><div id=\"control-msg\" role=\"status\" class=\"message\"></div></section>\n<section class=\"panel\"><h2>Control thresholds</h2><form id=\"settings\">\n<fieldset><legend>Lamp temperature (°C)</legend><div class=\"fields\"><label>Switch on above<input required disabled type=\"number\" id=\"on\" step=\"any\" min=\"-40\" max=\"100\"></label><label>Switch off at or below<input required disabled type=\"number\" id=\"off\" step=\"any\" min=\"-40\" max=\"100\"></label></div></fieldset>\n<fieldset><legend>Water level (%)</legend><div class=\"fields\"><label>Alert below<input required disabled type=\"number\" id=\"low\" step=\"any\" min=\"0\" max=\"100\"></label><label>Clear alert at or above<input required disabled type=\"number\" id=\"clear\" step=\"any\" min=\"0\" max=\"100\"></label></div></fieldset>\n<button class=\"primary\" id=\"save\" disabled>Apply thresholds</button></form><div id=\"settings-msg\" role=\"status\" class=\"message\"></div><p class=\"note\">With default Node-RED storage, settings reset when the service restarts.</p></section></div></div>\n<footer>Sensor readings expire after 15 seconds. Times are shown in the browser’s local time.</footer></main>\n<script>\nconst el=id=>document.getElementById(id);\nconst keys=['on','off','low','clear'];\nconst modes={auto:'Automatic',on:'Manual · on',off:'Manual · off'};\nconst series={temperatura:['Temperature','°C','#995415'],humedad:['Relative humidity','%','#325c96'],nivel:['Water level','%','#176754']};\nconst fmt=n=>n.toLocaleString('en-GB',{maximumFractionDigits:2});\nconst time=t=>new Date(t).toLocaleTimeString('en-GB');\nconst stateText=v=>v==='1'?'On':v==='0'?'Off':'—';\nlet editing=false,busy=false,current=null,selected='temperatura';\nfunction graph(){\n  const canvas=el('plot'),w=canvas.clientWidth,h=canvas.clientHeight,scale=window.devicePixelRatio||1;\n  if(!w||!h)return;\n  canvas.width=Math.round(w*scale);canvas.height=Math.round(h*scale);\n  const ctx=canvas.getContext('2d');ctx.scale(scale,scale);\n  const now=current?.time||Date.now(),start=now-300000;\n  const points=(current?.history?.[selected]||[]).filter(([t])=>t>=start&&t<=now);\n  const values=points.map(p=>p[1]).filter(Number.isFinite);\n  const [name,unit,color]=series[selected],left=43,right=w-15,top=31,bottom=h-29;\n  const min=values.length?Math.min(...values):0,max=values.length?Math.max(...values):0;\n  const step=Math.max(0.5,Math.ceil((max-min)/4*2)/2);\n  const low=Math.floor(min/step)*step,high=Math.max(low+2*step,Math.ceil(max/step)*step);\n  const x=t=>left+(t-start)/300000*(right-left),y=v=>bottom-(v-low)/(high-low)*(bottom-top);\n  ctx.font='12px system-ui';ctx.fillStyle='#485f69';ctx.fillText(unit,7,17);\n  for(let v=low;v<=high+step/100;v+=step){\n    ctx.strokeStyle='#dbe2e0';ctx.beginPath();ctx.moveTo(left,y(v));ctx.lineTo(right,y(v));ctx.stroke();\n    if(values.length){ctx.textAlign='right';ctx.fillText(fmt(v),left-6,y(v)+4);}\n  }\n  for(const [i,label] of [[0,'−5 min'],[1,'−4'],[2,'−3'],[3,'−2'],[4,'−1'],[5,'Now']]){\n    ctx.textAlign=i===0?'left':i===5?'right':'center';ctx.fillText(label,left+i*(right-left)/5,h-8);\n  }\n  ctx.strokeStyle=color;ctx.lineWidth=2;ctx.fillStyle=color;\n  let previous=null;\n  for(const [t,v] of points){\n    if(!Number.isFinite(v)){previous=null;continue;}\n    if(previous && t-previous[0]<15000){\n      ctx.beginPath();ctx.moveTo(x(previous[0]),y(previous[1]));ctx.lineTo(x(t),y(v));ctx.stroke();\n    }\n    ctx.beginPath();ctx.arc(x(t),y(v),2.5,0,Math.PI*2);ctx.fill();previous=[t,v];\n  }\n  const caption=values.length?name+' · '+values.length+' measured sample'+(values.length===1?'':'s')+' · Min '+fmt(min)+' '+unit+' · Max '+fmt(max)+' '+unit:'Waiting for '+name.toLowerCase()+' samples.';\n  el('plot-summary').textContent=caption;canvas.setAttribute('aria-label',caption);\n}\nfunction render(data){\n  current=data;\n  const lamp=data?.lamp||{};\n  el('connection').textContent=data?(lamp.connected?'MQTT connected':'MQTT disconnected'):'Panel offline';\n  el('connection').classList.toggle('online',Boolean(lamp.connected));\n  el('updated').textContent=data?time(data.time):'—';\n  for(const k of Object.keys(series)){\n    const value=data?.samples?.[k],fresh=Number.isFinite(value);\n    el(k).textContent=fresh?fmt(value):'—';\n    if(k!=='nivel'){\n      const points=data?.history?.[k]||[],last=points[points.length-1];\n      el('age-'+k).textContent=fresh&&last?'Received '+time(last[0]):'No current reading';\n    }\n  }\n  el('water').textContent=({red:'Low water alert',green:'Normal level'})[data?.water]||'No current reading';\n  el('mode').textContent=modes[lamp.mode]||'—';el('requested').textContent=stateText(lamp.requested);\n  el('report').textContent=data?.report?stateText(data.report.value)+' · '+time(data.report.at):'Awaiting report';\n  for(const b of document.querySelectorAll('[data-mode]')){\n    b.disabled=busy||!lamp.connected||(b.dataset.mode==='on'&&!lamp.fresh);\n    b.setAttribute('aria-pressed',String(lamp.mode===b.dataset.mode));\n  }\n  for(const k of keys){el(k).disabled=!data||busy;if(!editing&&data)el(k).value=data.settings[k];}\n  el('save').disabled=!data||busy;graph();\n}\nasync function refresh(){\n  try{const r=await fetch('/ui/panel',{cache:'no-store'});if(!r.ok)throw Error();render(await r.json());}\n  catch{render(null);}\n}\nasync function send(body,where){\n  if(busy)return;\n  busy=true;render(current);where.textContent='';\n  try{const r=await fetch('/ui/control',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});\n    const data=await r.json();where.textContent=data.message;if(r.ok&&body.action==='settings')editing=false;\n  }catch{where.textContent='Unable to confirm the change. Check the connection.';}\n  finally{await refresh();busy=false;render(current);}\n}\nfor(const b of document.querySelectorAll('[data-mode]')) b.onclick=()=>send({action:b.dataset.mode},el('control-msg'));\nfor(const b of document.querySelectorAll('[data-series]')) b.onclick=()=>{\n  selected=b.dataset.series;for(const item of document.querySelectorAll('[data-series]'))item.setAttribute('aria-pressed',String(item===b));graph();\n};\nnew ResizeObserver(graph).observe(el('plot'));\nel('settings').oninput=()=>{editing=true;};\nel('settings').onsubmit=e=>{e.preventDefault();send({action:'settings',...Object.fromEntries(keys.map(k=>[k,el(k).valueAsNumber]))},el('settings-msg'));};\n(async function poll(){if(!busy)await refresh();setTimeout(poll,1000);})();\n</script></body></html>\n",
    "output": "str",
