  {
    "id": "mqtt-display-in",
    "z": "mqtt-display-tab",
    "type": "mqtt in",
    "name": "Temperatura desde HiveMQ",
    "topic": "IIoT/CHANGE_ME/temperatura",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt-display-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 160,
    "wires": [
      [
        "mqtt-display-validate",
        "mqtt-display-raw"
      ]
    ]
  },
  {
    "id": "mqtt-display-validate",
    "z": "mqtt-display-tab",
    "type": "function",
    "name": "Validar temperatura",
    "func": "function toDisplayMessage(msg) {\n  if (msg.retain === true) return null;\n  let data = msg.payload;\n  if (typeof data === 'string') {\n    if (data.length > 1024) return null;\n    try { data = JSON.parse(data); } catch (_) { return null; }\n  }\n  const temperature = typeof data === 'number' ? data :\n    data && data.valid === true && data.unit === 'C' ? data.value : null;\n  if (typeof temperature !== 'number' || !Number.isFinite(temperature) ||\n      temperature < -40 || temperature > 100) return null;\n  // Only this numeric argument reaches exec; discard unrelated message fields.\n  return {payload: temperature.toFixed(1)};\n}\nconst result = toDisplayMessage(msg);\nif (!result) node.warn(\"Lectura inválida o retenida: no se muestra\");\nreturn result;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 160,
    "wires": [
      [
        "mqtt-display-rate"
      ]
    ]
  },
  {
    "id": "mqtt-display-rate",
    "z": "mqtt-display-tab",
    "type": "delay",
    "name": "Máximo una lectura cada 5 s",
    "pauseType": "rate",
    "timeout": "5",
    "timeoutUnits": "seconds",
    "rate": "1",
    "nbRateUnits": "5",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": true,
    "allowrate": false,
    "outputs": 1,
    "x": 730,
    "y": 160,
    "wires": [
      [
        "mqtt-display-exec"
      ]
    ]
  },
  {
    "id": "mqtt-display-exec",
